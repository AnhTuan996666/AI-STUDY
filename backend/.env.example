# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM provider: ollama | mock ---
# dùng "mock" khi chưa cài Ollama để vẫn dev/test được frontend
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# --- Hàng đợi trước model server ---
# LLM_MAX_CONCURRENT: số lượt sinh chạy song song. Đặt BẰNG OLLAMA_NUM_PARALLEL.
#   GPU 8GB / model 7B -> 2. GPU 12-16GB -> 4. Chạy CPU -> 1.
# LLM_MAX_QUEUE: sức chứa hàng đợi. Vượt quá -> trả 503 queue_full ngay.
# LLM_QUEUE_TIMEOUT_SECONDS: chờ lâu hơn mức này thì bỏ cuộc -> 503 queue_timeout.
QUEUE_BACKEND=local
LLM_MAX_CONCURRENT=2
LLM_MAX_QUEUE=32
LLM_QUEUE_TIMEOUT_SECONDS=60

# --- Chat ---
SYSTEM_PROMPT=Bạn là trợ lý AI hữu ích, trả lời ngắn gọn, chính xác bằng tiếng Việt.
MAX_HISTORY_MESSAGES=20

# --- Database (PostgreSQL) ---
# Bỏ trống DATABASE_NAME = chạy in-memory: tài khoản và cài đặt MẤT khi restart.
# Tạo DB trước khi chạy:  createdb -U postgres ai_chat
# Rồi tạo bảng:           .venv\Scripts\alembic upgrade head
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=ai_chat
# Dịch vụ hosting (Render/Railway/Supabase) phát sẵn 1 chuỗi -> dán vào đây, nó
# ghi đè 5 biến trên. Nhớ đổi tiền tố thành postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DB_ECHO=false

# --- JWT (phiên đăng nhập) ---
# Sinh khoá (tối thiểu 32 byte):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Đổi khoá này = đăng xuất toàn bộ người dùng đang online.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=604800

# --- Đăng nhập bằng Google ---
# Lấy tại https://console.cloud.google.com/apis/credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   -> Authorized redirect URIs: dán ĐÚNG giá trị GOOGLE_REDIRECT_URI bên dưới.
# Bỏ trống 2 biến đầu = tắt đăng nhập Google (endpoint trả 503 kèm giải thích).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- CORS: ngăn cách bằng dấu phẩy ---
# Cũng là danh sách địa chỉ được phép nhận token sau khi đăng nhập Google.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limit (in-memory, theo IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
